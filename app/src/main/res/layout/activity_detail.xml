<?xml version="1.0" encoding="utf-8"?>
<!-- Part F: layout of the DetailActivity (Figure 5).
     Top:    photo banner with a section icon and the section title overlaid.
     Bottom: a title heading and a scrollable block of content text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top banner: photo + icon + section title -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/banner_description"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/banner_padding">

            <ImageView
                android:id="@+id/detail_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/detail_icon_description"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_facilities" />

            <TextView
                android:id="@+id/detail_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_padding"
                android:paddingLeft="@dimen/screen_padding"
                android:text="@string/facilities"
                android:textColor="@android:color/white"
                android:textSize="@dimen/section_title_size"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Content area: title heading + scrollable body text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_title_placeholder"
            android:textSize="@dimen/detail_title_size"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/text_spacing"
                android:text="@string/detail_content_placeholder"
                android:textSize="@dimen/content_text_size" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
