<?xml version="1.0" encoding="utf-8"?>
<!-- Part D: LANDSCAPE layout of the MainActivity.
     Top:  photo banner with the welcome text overlaid.
     Bottom: the four option ImageButtons placed in a single horizontal row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Upper banner: campus photo with welcome text -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/banner_description"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/text_spacing"
            android:text="@string/welcome_text"
            android:textColor="@android:color/white"
            android:textSize="@dimen/banner_title_size"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Lower section: four buttons side by side in one row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_facilities"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/button_selector"
            android:contentDescription="@string/facilities"
            android:onClick="onFacilitiesClick"
            android:padding="@dimen/button_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/img_btn_facilities" />

        <ImageButton
            android:id="@+id/btn_events"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/button_selector"
            android:contentDescription="@string/events"
            android:onClick="onEventsClick"
            android:padding="@dimen/button_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/img_btn_events" />

        <ImageButton
            android:id="@+id/btn_clubs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/button_selector"
            android:contentDescription="@string/clubs"
            android:onClick="onClubsClick"
            android:padding="@dimen/button_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/img_btn_clubs" />

        <ImageButton
            android:id="@+id/btn_support"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/button_selector"
            android:contentDescription="@string/support"
            android:onClick="onSupportClick"
            android:padding="@dimen/button_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/img_btn_support" />
    </LinearLayout>

</LinearLayout>
